# Copy this file to .env and fill in real values before running the app.

# ---- App ----
NODE_ENV=production
PORT=3000
# Public URL of this deployment (no trailing slash). Used to build the
# Google OAuth redirect URI.
APP_URL=https://yourdomain.com

# ---- Session ----
# Generate with: openssl rand -base64 48
JWT_SECRET=

# ---- Database (Turso / libSQL) ----
# Get these by running `turso db show <name> --url` and
# `turso db tokens create <name>` after creating a database at turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Admin ----
# The email address that automatically becomes an admin on sign-up.
OWNER_EMAIL=you@example.com

# ---- Google login (optional) ----
# Leave blank to disable "Continue with Google" and use email/password only.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- File storage (AWS S3) ----
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Owner email notifications (optional) ----
# Uses Resend (https://resend.com). Leave blank to skip notifications —
# the app degrades gracefully and just logs a warning instead.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=notifications@yourdomain.com
NOTIFY_OWNER_EMAIL=you@example.com
